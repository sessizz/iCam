// Signing.xcconfig
//
// The only file you need to edit before building:
//
//   DEVELOPMENT_TEAM  – your 10-character Apple Developer Team ID
//                       (Xcode › Settings › Accounts, or developer.apple.com › Membership).
//   BUNDLE_ID_PREFIX  – a reverse-DNS prefix you own, e.g. com.yourname.icam
//
// Bundle identifiers derived from it:
//   iPhone app        $(BUNDLE_ID_PREFIX)
//   Mac app           $(BUNDLE_ID_PREFIX).mac
//   Camera extension  $(BUNDLE_ID_PREFIX).mac.CameraExtension

DEVELOPMENT_TEAM = TW9F922D62
BUNDLE_ID_PREFIX = com.example.icam

MARKETING_VERSION = 1.0
// Bump this whenever you change the camera extension so macOS replaces the
// installed copy.
CURRENT_PROJECT_VERSION = 1
